{
  "name": "Signpost: Bookmark Desktop for New Tab",
  "description": "Turn your new tab into a visual bookmark desktop. Quickly save pages; drag & resize tiles; customize colors, opacity & wallpapers.",
  "version": "3.3",
  "manifest_version": 3,
  "chrome_url_overrides": {
    "newtab": "signpost.html"
  },
  "action": {
    "default_title": "Signpost",
    "default_popup": "action-menu.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "bookmarks",
    "contextMenus",
    "favicon",
    "storage",
    "tabs"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
